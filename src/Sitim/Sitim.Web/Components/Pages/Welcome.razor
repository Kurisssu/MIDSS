@page "/"
@attribute [Authorize]
@using System.Globalization
@inject NavigationManager Navigation
@inject AuthTokenStore TokenStore
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Welcome.PageTitle"]</PageTitle>

<!-- ═══════════════════════════════════════════════════════════════
     1. HERO GREETING
     ═══════════════════════════════════════════════════════════════ -->
<section class="sitim-welcome-hero">
    <div class="sitim-welcome-hero-content">
        <div class="sitim-welcome-hero-text">
            <h1 class="sitim-welcome-greeting">@_greeting, @_displayName</h1>
            <p class="sitim-welcome-subline">
                <span>@_dateString</span>
                @if (!string.IsNullOrWhiteSpace(TokenStore.InstitutionName))
                {
                    <span class="sitim-welcome-dot">&middot;</span>
                    <span>@TokenStore.InstitutionName</span>
                }
            </p>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     2. KPI GRID
     ═══════════════════════════════════════════════════════════════ -->
<section class="sitim-welcome-section">
    <div class="sitim-welcome-kpi-grid">

        <RadzenCard class="sitim-welcome-kpi-card">
            <RadzenIcon Icon="biotech" class="sitim-welcome-kpi-icon sitim-kpi-icon-teal" />
            <div class="sitim-welcome-kpi-value sitim-text-gradient">@_stats.StudiesThisMonth</div>
            <div class="sitim-welcome-kpi-label">@L["Welcome.StudiesThisMonth"]</div>
            @if (_stats.StudiesTrendPct != 0)
            {
                <div class="sitim-welcome-kpi-trend @(_stats.StudiesTrendPct > 0 ? "sitim-trend-up" : "sitim-trend-down")">
                    @(_stats.StudiesTrendPct > 0 ? "↗" : "↘") @(Math.Abs(_stats.StudiesTrendPct))%
                </div>
            }
        </RadzenCard>

        <RadzenCard class="sitim-welcome-kpi-card">
            <RadzenIcon Icon="psychology" class="sitim-welcome-kpi-icon sitim-kpi-icon-cyan" />
            <div class="sitim-welcome-kpi-value sitim-text-gradient">@_stats.AiAnalysesThisMonth</div>
            <div class="sitim-welcome-kpi-label">@L["Welcome.AIAnalysesThisMonth"]</div>
            @if (_stats.AiAnalysesTrendPct != 0)
            {
                <div class="sitim-welcome-kpi-trend @(_stats.AiAnalysesTrendPct > 0 ? "sitim-trend-up" : "sitim-trend-down")">
                    @(_stats.AiAnalysesTrendPct > 0 ? "↗" : "↘") @(Math.Abs(_stats.AiAnalysesTrendPct))%
                </div>
            }
        </RadzenCard>

        <RadzenCard class="sitim-welcome-kpi-card">
            <RadzenIcon Icon="pending" class="sitim-welcome-kpi-icon sitim-kpi-icon-amber" />
            <div class="sitim-welcome-kpi-value sitim-kpi-value-amber">@_stats.InProgress</div>
            <div class="sitim-welcome-kpi-label">
                @L["Welcome.InProgressNow"]&nbsp;<span class="sitim-live-badge">live</span>
            </div>
        </RadzenCard>

        @* Management metric — only meaningful for users who actually manage other users *@
        @if (_isManager)
        {
            <RadzenCard class="sitim-welcome-kpi-card">
                <RadzenIcon Icon="group" class="sitim-welcome-kpi-icon sitim-kpi-icon-violet" />
                <div class="sitim-welcome-kpi-value sitim-kpi-value-violet">@_stats.ActiveUsers</div>
                <div class="sitim-welcome-kpi-label">@L["Welcome.ActiveUsers"]</div>
            </RadzenCard>
        }

    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     3. RECENT ACTIVITY
     ═══════════════════════════════════════════════════════════════ -->
<section class="sitim-welcome-section">
    <div class="sitim-welcome-activity-grid">

        <RadzenCard class="sitim-welcome-activity-card">
            <div class="sitim-welcome-card-header">
                <RadzenIcon Icon="schedule" class="sitim-welcome-card-icon" />
                <span class="sitim-welcome-card-title">@L["Welcome.RecentStudies"]</span>
            </div>
            @if (_recentStudies.Count > 0)
            {
                <ul class="sitim-welcome-list">
                    @foreach (var study in _recentStudies)
                    {
                        <li class="sitim-welcome-list-item" @onclick="@(() => Navigation.NavigateTo("/studies"))">
                            <div class="sitim-welcome-list-primary">@study.Modality — @study.PatientLabel</div>
                            <div class="sitim-welcome-list-secondary">@study.RelativeTime &middot; @study.Meta</div>
                        </li>
                    }
                </ul>
                <div class="sitim-welcome-card-footer">
                    <span class="sitim-welcome-footer-link" @onclick="@(() => Navigation.NavigateTo("/studies"))">
                        → @L["Welcome.SeeAllStudies"]
                    </span>
                </div>
            }
            else
            {
                <div class="sitim-welcome-empty">
                    <RadzenIcon Icon="folder_open" class="sitim-welcome-empty-icon" />
                    <p>@L["Welcome.NoStudiesYet"]</p>
                    <RadzenButton Text="@L["Welcome.ImportFirstStudy"]" Icon="cloud_upload"
                                  ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                  Click="@(() => Navigation.NavigateTo("/import"))" />
                </div>
            }
        </RadzenCard>

        <RadzenCard class="sitim-welcome-activity-card">
            <div class="sitim-welcome-card-header">
                <RadzenIcon Icon="psychology" class="sitim-welcome-card-icon" />
                <span class="sitim-welcome-card-title">@L["Welcome.RecentAnalyses"]</span>
            </div>
            @if (_recentAnalyses.Count > 0)
            {
                <ul class="sitim-welcome-list">
                    @foreach (var analysis in _recentAnalyses)
                    {
                        <li class="sitim-welcome-list-item" @onclick="@(() => Navigation.NavigateTo("/ai-analyses"))">
                            <div class="sitim-welcome-list-primary">
                                @analysis.AnalysisType
                                <span class="sitim-welcome-confidence">@L["Welcome.ConfidencePct", analysis.Confidence]</span>
                            </div>
                            <div class="sitim-welcome-list-secondary">
                                @analysis.StudyLabel &middot;
                                <span class="sitim-dr-badge sitim-dr-@analysis.SeverityClass">@analysis.PredictedClass</span>
                            </div>
                        </li>
                    }
                </ul>
                <div class="sitim-welcome-card-footer">
                    <span class="sitim-welcome-footer-link" @onclick="@(() => Navigation.NavigateTo("/ai-analyses"))">
                        → @L["Welcome.SeeAllAnalyses"]
                    </span>
                </div>
            }
            else
            {
                <div class="sitim-welcome-empty">
                    <RadzenIcon Icon="science" class="sitim-welcome-empty-icon" />
                    <p>@L["Welcome.NoAnalysesYet"]</p>
                    <RadzenButton Text="@L["Welcome.StartAnalysis"]" Icon="play_arrow"
                                  ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                  Click="@(() => Navigation.NavigateTo("/studies"))" />
                </div>
            }
        </RadzenCard>

    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     4. QUICK ACTIONS
     ═══════════════════════════════════════════════════════════════ -->
<section class="sitim-welcome-section">
    <div class="sitim-welcome-quick-grid">

        <div class="sitim-welcome-quick-card" @onclick="@(() => Navigation.NavigateTo("/import"))">
            <RadzenIcon Icon="cloud_upload" class="sitim-welcome-quick-icon" />
            <span class="sitim-welcome-quick-label">@L["Nav.Import"]</span>
        </div>

        <div class="sitim-welcome-quick-card" @onclick="@(() => Navigation.NavigateTo("/studies"))">
            <RadzenIcon Icon="search" class="sitim-welcome-quick-icon" />
            <span class="sitim-welcome-quick-label">@L["Welcome.SearchStudy"]</span>
        </div>

        <div class="sitim-welcome-quick-card" @onclick="@(() => Navigation.NavigateTo("/ai-analyses"))">
            <RadzenIcon Icon="psychology" class="sitim-welcome-quick-icon" />
            <span class="sitim-welcome-quick-label">@L["Nav.AIAnalyses"]</span>
        </div>

    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     5. STATUS FOOTER
     ═══════════════════════════════════════════════════════════════ -->
<footer class="sitim-welcome-status">
    <span class="sitim-status-pill sitim-status-ok">@L["Welcome.SystemOperational"]</span>
    <span class="sitim-status-sep">&middot;</span>
    <span class="sitim-status-pill sitim-status-ok">@L["Welcome.PACSConnected"]</span>
    <span class="sitim-status-sep">&middot;</span>
    <span class="sitim-status-pill sitim-status-ok">@L["Welcome.AIServiceActive"]</span>
</footer>

<!-- ═══════════════════════════════════════════════════════════════
     ADMIN — visible only to Admin / SuperAdmin
     ═══════════════════════════════════════════════════════════════ -->
@if (TokenStore.IsSuperAdmin || TokenStore.Roles.Contains("Admin"))
{
    <section class="sitim-welcome-section">
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem">
                <RadzenText Text="@L["Welcome.AdminSections"]" TextStyle="TextStyle.Subtitle1" />
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Text="@L["Nav.Users"]" Icon="group" ButtonStyle="ButtonStyle.Light"
                                  Click="@(() => Navigation.NavigateTo("/users"))" />
                    <RadzenButton Text="@L["Nav.Admin"]" Icon="admin_panel_settings" ButtonStyle="ButtonStyle.Light"
                                  Click="@(() => Navigation.NavigateTo("/admin"))" />
                    @if (TokenStore.IsSuperAdmin)
                    {
                        <RadzenButton Text="@L["Nav.Institutions"]" Icon="business" ButtonStyle="ButtonStyle.Light"
                                      Click="@(() => Navigation.NavigateTo("/institutions"))" />
                        <RadzenButton Text="@L["Nav.AIModels"]" Icon="psychology" ButtonStyle="ButtonStyle.Light"
                                      Click="@(() => Navigation.NavigateTo("/ai-models"))" />
                        <RadzenButton Text="Federated Learning" Icon="hub" ButtonStyle="ButtonStyle.Light"
                                      Click="@(() => Navigation.NavigateTo("/federated-learning"))" />
                    }
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </section>
}

@code {
    private string _greeting    = "";
    private string _displayName = "";
    private string _initials    = "?";
    private string _dateString  = "";

    /// <summary>
    /// True when the current user can manage other users (Admin / SuperAdmin).
    /// Doctors and Technicians don't have user-management context, so we hide
    /// "Active users" — a metric meaningful only to people who can act on it.
    /// </summary>
    private bool _isManager => TokenStore.IsSuperAdmin || TokenStore.Roles.Contains("Admin");

    // TODO: Replace with real API call to /api/dashboard/stats
    private DashboardStats _stats = new()
    {
        StudiesThisMonth    = 142,
        StudiesTrendPct     = 12,
        AiAnalysesThisMonth = 28,
        AiAnalysesTrendPct  = 5,
        InProgress          = 3,
        ActiveUsers         = 12
    };

    // TODO: Replace with real API call to /api/dashboard/recent-studies
    // Demo data is built in OnInitialized so the localizer is available.
    private List<RecentStudy> _recentStudies = [];

    // TODO: Replace with real API call to /api/dashboard/recent-analyses
    private List<RecentAnalysis> _recentAnalyses = [];

    protected override void OnInitialized()
    {
        var now = DateTime.Now;

        _greeting = now.Hour switch
        {
            >= 6 and < 12  => L["Welcome.GoodMorning"],
            >= 12 and < 18 => L["Welcome.GoodAfternoon"],
            >= 18 and < 22 => L["Welcome.GoodEvening"],
            _              => L["Welcome.GoodNight"]
        };

        _recentStudies =
        [
            new() { Modality = L["Welcome.DemoCTChest"],    PatientLabel = L["Welcome.PatientNo", 1245], RelativeTime = L["Welcome.HoursAgo", 2],       Meta = L["Welcome.ImagesCount", 128] },
            new() { Modality = L["Welcome.DemoBrainMRI"],   PatientLabel = L["Welcome.PatientNo", 1244], RelativeTime = L["Welcome.HoursAgo", 5],       Meta = L["Welcome.ImagesCount", 64]  },
            new() { Modality = L["Welcome.DemoUltrasound"], PatientLabel = L["Welcome.PatientNo", 1243], RelativeTime = L["Welcome.YesterdayAt", "14:30"], Meta = L["Welcome.ImagesCount", 12] },
            new() { Modality = L["Welcome.DemoXRay"],       PatientLabel = L["Welcome.PatientNo", 1242], RelativeTime = L["Welcome.YesterdayAt", "09:15"], Meta = L["Welcome.ImagesCount", 3]  },
        ];

        _recentAnalyses =
        [
            new() { AnalysisType = L["Welcome.Retinopathy"], Confidence = 96, StudyLabel = L["Welcome.StudyNo", 8821], PredictedClass = "Moderate DR", SeverityClass = "moderate" },
            new() { AnalysisType = L["Welcome.Retinopathy"], Confidence = 99, StudyLabel = L["Welcome.StudyNo", 8820], PredictedClass = "No DR",       SeverityClass = "none"     },
            new() { AnalysisType = L["Welcome.Retinopathy"], Confidence = 87, StudyLabel = L["Welcome.StudyNo", 8819], PredictedClass = "Mild DR",     SeverityClass = "mild"     },
            new() { AnalysisType = L["Welcome.Retinopathy"], Confidence = 94, StudyLabel = L["Welcome.StudyNo", 8818], PredictedClass = "Severe DR",   SeverityClass = "severe"   },
        ];

        var email = TokenStore.Email ?? "";
        var local = email.Contains('@') ? email[..email.IndexOf('@')] : email;
        var parts = local.Split(['.', '_', '-'], StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
        {
            _displayName = string.Join(" ", parts.Select(
                p => p.Length > 0 ? char.ToUpper(p[0]) + p[1..].ToLower() : ""));
            _initials = $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}";
        }
        else if (parts.Length == 1 && parts[0].Length > 0)
        {
            _displayName = char.ToUpper(parts[0][0]) + parts[0][1..].ToLower();
            _initials    = $"{char.ToUpper(parts[0][0])}";
        }
        else
        {
            _displayName = email;
            _initials    = "?";
        }

        _dateString = now.ToString("dddd, d MMMM yyyy", CultureInfo.CurrentCulture);
        if (_dateString.Length > 0)
            _dateString = char.ToUpper(_dateString[0]) + _dateString[1..];
    }

    private sealed class DashboardStats
    {
        public int StudiesThisMonth    { get; init; }
        public int StudiesTrendPct     { get; init; }
        public int AiAnalysesThisMonth { get; init; }
        public int AiAnalysesTrendPct  { get; init; }
        public int InProgress          { get; init; }
        public int ActiveUsers         { get; init; }
    }

    private sealed class RecentStudy
    {
        public string Modality     { get; init; } = "";
        public string PatientLabel { get; init; } = "";
        public string RelativeTime { get; init; } = "";
        public string Meta         { get; init; } = "";
    }

    private sealed class RecentAnalysis
    {
        public string AnalysisType   { get; init; } = "";
        public int    Confidence     { get; init; }
        public string StudyLabel     { get; init; } = "";
        public string PredictedClass { get; init; } = "";
        public string SeverityClass  { get; init; } = "none";
    }
}
