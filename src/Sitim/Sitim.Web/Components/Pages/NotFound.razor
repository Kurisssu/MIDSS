@page "/not-found"
@layout NotFoundLayout
@attribute [AllowAnonymous]
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["NotFoundPage.PageTitle"]</PageTitle>
<RadzenRow AlignItems="Radzen.AlignItems.Center">
    <RadzenColumn Size="12">
        <RadzenText TextStyle="Radzen.Blazor.TextStyle.DisplayH4" class="rz-mt-6 rz-mt-md-12 rz-pt-md-12 rz-mx-auto" Text="@L["NotFoundPage.Title"]" TextAlign="Radzen.TextAlign.Center" />
        <RadzenText Text="@L["NotFoundPage.Subtitle"]" TextStyle="Radzen.Blazor.TextStyle.Subtitle1" class="rz-mb-4 rz-mb-sm-12" TextAlign="Radzen.TextAlign.Center" />
        <RadzenText TextStyle="Radzen.Blazor.TextStyle.Body1" class="rz-mb-4 rz-mb-sm-12" TextAlign="Radzen.TextAlign.Center">
            <RadzenLink Path="/" Text="@L["NotFoundPage.GoHome"]" />
        </RadzenText>
    </RadzenColumn>
</RadzenRow>
