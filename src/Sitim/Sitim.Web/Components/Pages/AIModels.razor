@page "/ai-models"
@using Microsoft.AspNetCore.Authorization
@using Sitim.Web.Services
@using Sitim.Web.Components.Dialogs
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
@inject SitimApiClient ApiClient
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["AIModels.PageTitle"]</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="8">
            <RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1" class="rz-mb-0">
                @L["Nav.AIModels"]
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-tertiary-color">
                @L["AIModels.Subtitle"]
            </RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenButton Text="@L["AIModels.UploadNew"]"
                          Icon="add" 
                          ButtonStyle="ButtonStyle.Primary" 
                          Click="@ShowUploadDialog"
                          Style="width: 100%;" />
        </RadzenColumn>
    </RadzenRow>

    @if (isLoading)
    {
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                <RadzenText>@L["AIModels.LoadingModels"]</RadzenText>
            </RadzenStack>
        </RadzenCard>
    }
    else if (models == null || !models.Any())
    {
        <RadzenCard>
            <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" class="rz-py-8">
                <RadzenIcon Icon="psychology" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
                <RadzenText TextStyle="TextStyle.H6" class="rz-text-tertiary-color">
                    @L["AIModels.Empty"]
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-tertiary-color">
                    @L["AIModels.EmptyHint"]
                </RadzenText>
            </RadzenStack>
        </RadzenCard>
    }
    else
    {
        <RadzenStack Gap="0.5rem">
            @foreach (var model in models)
            {
                <RadzenCard>
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="12" SizeMD="10">
                            <RadzenRow>
                                <RadzenColumn Size="6" SizeMD="2">
                                    <RadzenText Text="@L["AIModels.ModelName"]" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
                                    <RadzenStack Gap="0.125rem">
                                        <RadzenText Text="@model.Name" TextStyle="TextStyle.Body2" />
                                        <RadzenText Text="@($"v{model.Version}")" TextStyle="TextStyle.Caption" />
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="5">
                                    <RadzenText Text="@L["Common.Description"]" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
                                    <RadzenText Text="@(string.IsNullOrWhiteSpace(model.Description) ? "—" : model.Description)" TextStyle="TextStyle.Body2" />
                                </RadzenColumn>
                                <RadzenColumn Size="6" SizeMD="1">
                                    <RadzenText Text="@L["AIModels.Accuracy"]" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
                                    <RadzenText Text="@(model.Accuracy.HasValue ? $"{model.Accuracy.Value:P1}" : "—")" TextStyle="TextStyle.Body2" />
                                </RadzenColumn>
                                <RadzenColumn Size="6" SizeMD="1">
                                    <RadzenText Text="@L["Common.Status"]" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
                                    <div>
                                        @if (model.IsActive)
                                        {
                                            <RadzenBadge Text="@L["Common.Active"]" BadgeStyle="BadgeStyle.Success" Variant="Variant.Flat" />
                                        }
                                        else
                                        {
                                            <RadzenBadge Text="@L["Common.Inactive"]" BadgeStyle="BadgeStyle.Secondary" Variant="Variant.Flat" />
                                        }
                                    </div>
                                </RadzenColumn>
                                <RadzenColumn Size="6" SizeMD="3">
                                    <RadzenText Text="@L["AIModels.UploadDate"]" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
                                    <RadzenText Text="@model.CreatedAt.ToString("dd.MM.yyyy HH:mm")" TextStyle="TextStyle.Body2" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="2" class="rz-text-align-end">
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                                <RadzenButton Icon="info"
                                              ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.Small"
                                              Click="@(() => ShowModelDetails(model))"
                                              title="@L["Common.Details"]" />
                                <RadzenButton Icon="edit"
                                              ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.Small"
                                              Click="@(() => ShowEditDialog(model))"
                                              title="@L["AIModels.EditClasses"]" />
                                <RadzenButton Icon="@(model.IsActive ? "toggle_on" : "toggle_off")"
                                              ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.Small"
                                              Click="@(() => ToggleModelStatus(model))"
                                              title="@(model.IsActive ? L["AIModels.Deactivate"] : L["AIModels.Activate"])" />
                                <RadzenButton Icon="delete"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Size="ButtonSize.Small"
                                              Click="@(() => DeleteModel(model))"
                                              title="@L["Common.Delete"]" />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenCard>
            }
        </RadzenStack>
    }
</RadzenStack>

@code {
    private List<AIModelDto>? models;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadModels();
    }

    private async Task LoadModels()
    {
        isLoading = true;
        try
        {
            models = await ApiClient.GetAIModelsAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, L["Common.Error"], L["Panel.LoadModelsFailed", ex.Message]);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ShowUploadDialog()
    {
        var result = await DialogService.OpenAsync<UploadModelDialog>(
            L["AIModels.UploadDialogTitle"],
            new Dictionary<string, object>
            {
                { "OnUploadComplete", EventCallback.Factory.Create(this, LoadModels) }
            },
            new DialogOptions
            {
                Width = "700px",
                Height = "auto",
                Resizable = false,
                Draggable = false
            }
        );

        if (result == true)
        {
            await LoadModels();
        }
    }

    private async Task ShowModelDetails(AIModelDto model)
    {
        await DialogService.OpenAsync<AIModelDetailsDialog>(
            L["AIModels.DetailsDialogTitle"],
            new Dictionary<string, object> { { "Model", model } },
            new DialogOptions
            {
                Width = "560px",
                Height = "auto",
                CloseDialogOnEsc = true,
                ShowClose = true
            }
        );
    }

    private async Task ShowEditDialog(AIModelDto model)
    {
        var result = await DialogService.OpenAsync<EditModelMetadataDialog>(
            L["AIModels.EditDialogTitle"],
            new Dictionary<string, object> { { "Model", model } },
            new DialogOptions
            {
                Width = "700px",
                Height = "auto",
                Resizable = false,
                Draggable = false,
                CloseDialogOnEsc = true,
                ShowClose = true
            }
        );

        if (result == true)
        {
            await LoadModels();
        }
    }

    private async Task ToggleModelStatus(AIModelDto model)
    {
        var confirmed = await DialogService.Confirm(
            model.IsActive
                ? L["AIModels.ConfirmDeactivate", model.Name]
                : L["AIModels.ConfirmActivate", model.Name],
            L["AIModels.ConfirmTitle"],
            new ConfirmOptions { OkButtonText = L["Common.Yes"], CancelButtonText = L["Common.Cancel"] }
        );

        if (confirmed == true)
        {
            try
            {
                var success = await ApiClient.ToggleModelStatusAsync(model.Id);
                if (success)
                {
                    NotificationService.Notify(NotificationSeverity.Success, L["Common.Success"],
                        model.IsActive ? L["AIModels.Deactivated"] : L["AIModels.Activated"]);
                    await LoadModels();
                }
                else
                {
                    NotificationService.Notify(NotificationSeverity.Error, L["Common.Error"], L["AIModels.ToggleFailed"]);
                }
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, L["Common.Error"], L["AIModels.ToggleFailedDetail", ex.Message]);
            }
        }
    }

    private async Task DeleteModel(AIModelDto model)
    {
        var confirmed = await DialogService.Confirm(
            L["AIModels.ConfirmDelete", model.Name, model.Version],
            L["AIModels.ConfirmDeleteTitle"],
            new ConfirmOptions { OkButtonText = L["Common.Delete"], CancelButtonText = L["Common.Cancel"] }
        );

        if (confirmed == true)
        {
            try
            {
                var success = await ApiClient.DeleteModelAsync(model.Id);
                if (success)
                {
                    NotificationService.Notify(NotificationSeverity.Success, L["Common.Success"], L["AIModels.Deleted"]);
                    await LoadModels();
                }
                else
                {
                    NotificationService.Notify(NotificationSeverity.Error, L["Common.Error"], L["AIModels.DeleteFailed"]);
                }
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, L["Common.Error"], L["AIModels.DeleteFailedDetail", ex.Message]);
            }
        }
    }

}
