@page "/institutions"
@using Sitim.Web.Services
@inject SitimApiClient Api
@inject NotificationService NotificationService
@inject IStringLocalizer<SharedResource> L
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin")]

<PageTitle>@L["Institutions.PageTitle"]</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="8">
            <RadzenText Text="@L["Nav.Institutions"]" TextStyle="TextStyle.H4" />
            <RadzenText Text="@L["Institutions.Subtitle"]" TextStyle="TextStyle.Body2" style="color: var(--rz-text-tertiary-color);" />
        </RadzenColumn>
        <RadzenColumn Size="4" class="rz-text-align-end">
            <RadzenButton Text="@L["Institutions.New"]" Icon="add" ButtonStyle="ButtonStyle.Primary"
                          Click="@OpenCreateDialog" />
        </RadzenColumn>
    </RadzenRow>

    @if (_loading)
    {
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        @if (!_institutions.Any())
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Light" AllowClose="false">
                @L["Institutions.Empty"]
            </RadzenAlert>
        }
        else
        {
            <RadzenStack Gap="0.5rem">
                @foreach (var row in _institutions)
                {
                    <RadzenCard>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="10">
                                <RadzenRow>
                                    <RadzenColumn Size="6" SizeMD="2">
                                        <RadzenText Text="@L["Institutions.Name"]" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
                                        <RadzenText Text="@row.Name" TextStyle="TextStyle.Body2" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeMD="2">
                                        <RadzenText Text="Slug" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
                                        <RadzenText Text="@row.Slug" TextStyle="TextStyle.Body2" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenText Text="@L["Institutions.OrthancUrl"]" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
                                        <RadzenText Text="@row.OrthancBaseUrl" TextStyle="TextStyle.Caption" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeMD="2">
                                        <RadzenText Text="@L["Common.Status"]" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
                                        <div>
                                            @if (row.IsActive)
                                            {
                                                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@L["Common.Active"]" />
                                            }
                                            else
                                            {
                                                <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@L["Common.Inactive"]" />
                                            }
                                        </div>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeMD="2">
                                        <RadzenText Text="@L["Institutions.CreatedAt"]" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
                                        <RadzenText Text="@row.CreatedAtUtc.ToString("yyyy-MM-dd")" TextStyle="TextStyle.Body2" />
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="2" class="rz-text-align-end">
                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                              Click="@(() => OpenEditDialog(row))" />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenCard>
                }
            </RadzenStack>
        }
    }
</RadzenStack>

@* Create dialog *@
<SitimModal Show="@_showCreateDialog" OnClose="@CloseDialogs">
    <RadzenCard Style="min-width:420px;max-width:600px;padding:2rem;">
        <RadzenText Text="@L["Institutions.New"]" TextStyle="TextStyle.H6" class="rz-mb-4" />
            <RadzenStack Gap="1rem">
                <RadzenFormField Text="@($"{L["Institutions.Name"]} *")" Style="width:100%">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="_newName" Placeholder="@L["Institutions.NamePlaceholder"]" Style="width:100%" />
                    </ChildContent>
                </RadzenFormField>
                <RadzenFormField Text="Slug *" Style="width:100%">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="_newSlug" Placeholder="@L["Institutions.SlugPlaceholder"]" Style="width:100%" />
                    </ChildContent>
                </RadzenFormField>
                <RadzenFormField Text="@($"{L["Institutions.OrthancUrl"]} *")" Style="width:100%">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="_newOrthancBaseUrl" Placeholder="@L["Institutions.OrthancUrlPlaceholder"]" Style="width:100%" />
                    </ChildContent>
                    <Helper>
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-tertiary-color);">
                            @L["Institutions.OrthancUrlHint"]
                        </RadzenText>
                    </Helper>
                </RadzenFormField>
                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="@L["Institutions.OrthancUser"]" Style="width:100%">
                            <ChildContent>
                                <RadzenTextBox @bind-Value="_newOrthancUsername" Placeholder="orthanc" Style="width:100%" />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="@L["Institutions.OrthancPassword"]" Style="width:100%">
                            <ChildContent>
                                <RadzenPassword @bind-Value="_newOrthancPassword" Placeholder="@L["Institutions.NoAuthPlaceholder"]" Style="width:100%" />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-2">
                    <RadzenButton Text="@L["Common.Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@CloseDialogs" />
                    <RadzenButton Text="@L["Institutions.Create"]" ButtonStyle="ButtonStyle.Primary"
                                  Click="@CreateInstitution" IsBusy="@_saving" />
                </RadzenStack>
            </RadzenStack>
    </RadzenCard>
</SitimModal>

@* Edit dialog *@
<SitimModal Show="@(_showEditDialog && _editTarget is not null)" OnClose="@CloseDialogs">
    @if (_editTarget is not null)
    {
        <RadzenCard Style="min-width:420px;max-width:600px;padding:2rem;">
            <RadzenText Text="@L["Institutions.Edit"]" TextStyle="TextStyle.H6" class="rz-mb-4" />
            <RadzenStack Gap="1rem">
                <RadzenFormField Text="@($"{L["Institutions.Name"]} *")" Style="width:100%">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="_editName" Style="width:100%" />
                    </ChildContent>
                </RadzenFormField>
                <RadzenFormField Text="@($"{L["Institutions.OrthancUrl"]} *")" Style="width:100%">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="_editOrthancBaseUrl" Style="width:100%" />
                    </ChildContent>
                </RadzenFormField>
                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="@L["Institutions.OrthancUser"]" Style="width:100%">
                            <ChildContent>
                                <RadzenTextBox @bind-Value="_editOrthancUsername" Placeholder="@L["Institutions.EmptyNoAuth"]" Style="width:100%" />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="@L["Institutions.OrthancPassword"]" Style="width:100%">
                            <ChildContent>
                                <RadzenPassword @bind-Value="_editOrthancPassword" Placeholder="@L["Institutions.EmptyKeepPassword"]" Style="width:100%" />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenCheckBox @bind-Value="_editIsActive" Name="isActive" />
                    <RadzenLabel Text="@L["Common.Active"]" Component="isActive" />
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-2">
                    <RadzenButton Text="@L["Common.Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@CloseDialogs" />
                    <RadzenButton Text="@L["Common.Save"]" ButtonStyle="ButtonStyle.Primary"
                                  Click="@UpdateInstitution" IsBusy="@_saving" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    }
</SitimModal>

@code {
    private List<InstitutionResult> _institutions = [];
    private bool _loading = true;
    private bool _saving = false;

    // Create dialog state
    private bool _showCreateDialog = false;
    private string _newName = "";
    private string _newSlug = "";
    private string _newOrthancBaseUrl = "";
    private string _newOrthancUsername = "";
    private string _newOrthancPassword = "";

    // Edit dialog state
    private bool _showEditDialog = false;
    private InstitutionResult? _editTarget = null;
    private string _editName = "";
    private string _editOrthancBaseUrl = "";
    private string _editOrthancUsername = "";
    private string _editOrthancPassword = "";
    private bool _editIsActive = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _institutions = await Api.GetInstitutionsAsync();
        _loading = false;
    }

    private void OpenCreateDialog()
    {
        _newName = _newSlug = _newOrthancBaseUrl = _newOrthancUsername = _newOrthancPassword = "";
        _showCreateDialog = true;
        _showEditDialog = false;
    }

    private void OpenEditDialog(InstitutionResult inst)
    {
        _editTarget = inst;
        _editName = inst.Name;
        _editOrthancBaseUrl = inst.OrthancBaseUrl;
        _editOrthancUsername = inst.OrthancUsername ?? "";
        _editOrthancPassword = "";
        _editIsActive = inst.IsActive;
        _showEditDialog = true;
        _showCreateDialog = false;
    }

    private void CloseDialogs()
    {
        _showCreateDialog = false;
        _showEditDialog = false;
    }

    private async Task CreateInstitution()
    {
        if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newSlug) || 
            string.IsNullOrWhiteSpace(_newOrthancBaseUrl))
        {
            NotificationService.Notify(NotificationSeverity.Warning, L["Institutions.FillRequired"]);
            return;
        }

        _saving = true;
        var result = await Api.CreateInstitutionAsync(_newName, _newSlug, _newOrthancBaseUrl,
            string.IsNullOrWhiteSpace(_newOrthancUsername) ? null : _newOrthancUsername,
            string.IsNullOrWhiteSpace(_newOrthancPassword) ? null : _newOrthancPassword);
        _saving = false;

        if (result is not null)
        {
            NotificationService.Notify(NotificationSeverity.Success, L["Institutions.CreatedDetail", result.Name]);
            CloseDialogs();
            await LoadAsync();
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Error, L["Institutions.CreateError"]);
        }
    }

    private async Task UpdateInstitution()
    {
        if (_editTarget is null || string.IsNullOrWhiteSpace(_editName) || string.IsNullOrWhiteSpace(_editOrthancBaseUrl)) 
            return;

        _saving = true;
        var result = await Api.UpdateInstitutionAsync(_editTarget.Id, _editName, _editOrthancBaseUrl, _editIsActive,
            string.IsNullOrWhiteSpace(_editOrthancUsername) ? null : _editOrthancUsername,
            string.IsNullOrWhiteSpace(_editOrthancPassword) ? null : _editOrthancPassword);
        _saving = false;

        if (result is not null)
        {
            NotificationService.Notify(NotificationSeverity.Success, L["Institutions.Updated"]);
            CloseDialogs();
            await LoadAsync();
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Error, L["Institutions.UpdateError"]);
        }
    }
}
