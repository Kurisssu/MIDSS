@page "/studies/{OrthancStudyId}"
@attribute [Authorize]
@inject SitimApiClient Api
@inject NavigationManager Navigation
@inject NotificationService Notification
@inject DialogService Dialog
@inject AuthTokenStore TokenStore
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["StudyDetails.PageTitle"]</PageTitle>

@if (isLoading)
{
    <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else if (study is null)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Dark" AllowClose="false">
        @L["StudyDetails.NotFound"]
    </RadzenAlert>
}
else
{
    <RadzenStack Gap="1rem">
        @* ── Header ──────────────────────────────────────── *@
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="12" SizeMD="8">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small"
                                  Click="@(() => Navigation.NavigateTo("/studies"))" title="@L["StudyDetails.BackToWorklist"]" />
                    <RadzenText Text="@L["StudyDetails.Title", study.PatientName ?? "N/A"]" TextStyle="TextStyle.DisplayH5" class="rz-mb-0" />
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Text="@L["StudyDetails.Sync"]" Icon="sync" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                                  Click="@OnSync" />
                    <AuthorizeView Roles="Admin,Doctor,Technician">
                        <RadzenButton Text="@L["StudyDetails.Analyze"]" Icon="science" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                      Click="@OnStartAnalysis" />
                    </AuthorizeView>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        @* ── Study details ──────────────────────────────── *@
        <RadzenCard>
            <RadzenText Text="@L["Studies.StudyDetails"]" TextStyle="TextStyle.H6" class="rz-mb-3" />
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Gap="0.5rem">
                        <RadzenFormField Text="@L["Common.Patient"]" Variant="Variant.Text"><ChildContent><RadzenTextBox ReadOnly="true" Value="@(study.PatientName ?? "—")" Style="width: 100%;" /></ChildContent></RadzenFormField>
                        <RadzenFormField Text="@L["Studies.PatientId"]" Variant="Variant.Text"><ChildContent><RadzenTextBox ReadOnly="true" Value="@(study.PatientId ?? "—")" Style="width: 100%;" /></ChildContent></RadzenFormField>
                        <RadzenFormField Text="@L["Studies.StudyDate"]" Variant="Variant.Text"><ChildContent><RadzenTextBox ReadOnly="true" Value="@FormatStudyDate(study.StudyDate)" Style="width: 100%;" /></ChildContent></RadzenFormField>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Gap="0.5rem">
                        @if (!IsDoctor)
                        {
                            <RadzenFormField Text="Orthanc ID" Variant="Variant.Text"><ChildContent><RadzenTextBox ReadOnly="true" Value="@study.OrthancStudyId" Style="width: 100%; font-family: monospace;" /></ChildContent></RadzenFormField>
                            <RadzenFormField Text="Study Instance UID" Variant="Variant.Text"><ChildContent><RadzenTextBox ReadOnly="true" Value="@(study.StudyInstanceUid ?? "—")" Style="width: 100%; font-family: monospace; font-size: 0.85rem;" /></ChildContent></RadzenFormField>
                        }
                        <div>
                            <RadzenText Text="@L["Studies.Modalities"]" TextStyle="TextStyle.Body2" class="rz-mb-1" style="color: var(--rz-text-tertiary-color);" />
                            @foreach (var mod in study.ModalitiesInStudy)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@mod" class="rz-mr-1" />
                            }
                        </div>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
            @if (!IsDoctor)
            {
                <RadzenText Text="@L["StudyDetails.SeriesCount", study.SeriesOrthancIds.Count]" TextStyle="TextStyle.Caption" class="rz-mt-3" style="color: var(--rz-text-tertiary-color);" />
            }
        </RadzenCard>

        @* ── OHIF Viewer ─────────────────────────────────── *@
        <RadzenCard>
            <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-3">
                <RadzenColumn>
                    <RadzenText Text="@L["StudyDetails.OHIFViewer"]" TextStyle="TextStyle.H6" class="rz-mb-0" />
                </RadzenColumn>
                <RadzenColumn>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        @if (!string.IsNullOrWhiteSpace(viewerUrl))
                        {
                            <RadzenButton Text="@L["StudyDetails.OpenNewTab"]" Icon="open_in_new" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Click="@OpenViewerExternal" />
                        }
                        else if (viewerUnavailable)
                        {
                            <RadzenButton Text="@L["StudyDetails.RetryViewer"]" Icon="refresh" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                                          Click="@LoadViewerUrl" IsBusy="@isLoadingViewer" BusyText="@L["Common.Loading"]" />
                        }
                        else
                        {
                            <RadzenButton Text="@L["StudyDetails.LoadViewer"]" Icon="play_arrow" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                                          Click="@LoadViewerUrl" IsBusy="@isLoadingViewer" BusyText="@L["Common.Loading"]" />
                        }
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

            @if (!string.IsNullOrWhiteSpace(viewerUrl))
            {
                <div style="width: 100%; height: 600px; border: 1px solid var(--rz-border-color); border-radius: var(--rz-border-radius);">
                    <iframe src="@viewerUrl" style="width: 100%; height: 100%; border: none; border-radius: var(--rz-border-radius);" allowfullscreen></iframe>
                </div>
            }
            else if (viewerUnavailable)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Light" AllowClose="false" class="rz-my-2">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenIcon Icon="cloud_off" />
                        <span>@L["StudyDetails.PACSUnavailable"]</span>
                    </RadzenStack>
                </RadzenAlert>
            }
            else
            {
                <RadzenText Text="@L["StudyDetails.PressLoadViewer"]" TextStyle="TextStyle.Body2"
                            style="color: var(--rz-text-tertiary-color);" TextAlign="TextAlign.Center" class="rz-py-6" />
            }
        </RadzenCard>

        @* ── Analyses on this study ──────────────────────────────── *@
        <RadzenCard>
            <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-2">
                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenText Text="@L["StudyDetails.AnalysesOnStudy"]" TextStyle="TextStyle.H6" class="rz-mb-0" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-end">
                    <RadzenButton Icon="refresh" Text="@L["Common.Reload"]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Click="@LoadStudyAnalyses" IsBusy="@isLoadingAnalyses" />
                </RadzenColumn>
            </RadzenRow>

            @if (isLoadingAnalyses)
            {
                <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            }
            else if (!studyAnalyses.Any())
            {
                <RadzenText Text="@L["StudyDetails.NoAnalysesYet"]" TextStyle="TextStyle.Body2"
                            style="color: var(--rz-text-secondary-color);" />
            }
            else
            {
                <RadzenStack Gap="0.5rem">
                    @foreach (var item in studyAnalyses)
                    {
                        <RadzenCard>
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="10">
                                    <RadzenRow>
                                        <RadzenColumn Size="6" SizeMD="3">
                                            <RadzenText Text="@L["Common.Status"]" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
                                            <div>
                                                <RadzenBadge BadgeStyle="@GetStatusBadgeStyle(item.Status)" Text="@item.Status" />
                                            </div>
                                        </RadzenColumn>
                                        <RadzenColumn Size="6" SizeMD="3">
                                            <RadzenText Text="@L["Common.Model"]" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
                                            <RadzenText Text="@(item.ModelName ?? "—")" TextStyle="TextStyle.Body2" />
                                        </RadzenColumn>
                                        <RadzenColumn Size="6" SizeMD="3">
                                            <RadzenText Text="@L["Common.CreatedAt"]" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
                                            <RadzenText Text="@FormatDateTime(item.CreatedAt)" TextStyle="TextStyle.Body2" />
                                        </RadzenColumn>
                                        <RadzenColumn Size="6" SizeMD="3">
                                            <RadzenText Text="@L["Common.Confidence"]" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
                                            <RadzenText Text="@(item.Confidence.HasValue ? item.Confidence.Value.ToString("P2") : "—")" TextStyle="TextStyle.Body2" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="2" class="rz-text-align-end">
                                    <RadzenButton Icon="arrow_forward" ButtonStyle="ButtonStyle.Info" Variant="Variant.Text" Size="ButtonSize.Small"
                                                  title="@L["StudyDetails.OpenAnalysis"]"
                                                  Click="@(() => OpenStudyAnalysis(item))" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenCard>
                    }
                </RadzenStack>
            }
        </RadzenCard>
    </RadzenStack>
}

@code {
    [Parameter] public string OrthancStudyId { get; set; } = "";

    private bool IsDoctor => TokenStore.Roles.Contains("Doctor") && !TokenStore.IsSuperAdmin;

    private Sitim.Core.Models.StudyDetails? study;
    private List<AIAnalysisJobListItemDto> studyAnalyses = new();
    private string? viewerUrl;
    private bool viewerUnavailable;
    private bool isLoading = true;
    private bool isLoadingViewer;
    private bool isLoadingAnalyses;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            study = await Api.GetLocalStudyAsync(OrthancStudyId);
            await LoadStudyAnalyses();
        }
        catch (Exception ex)
        {
            Notification.Notify(NotificationSeverity.Error, L["Common.Error"], ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadViewerUrl()
    {
        isLoadingViewer = true;
        viewerUnavailable = false;
        try
        {
            viewerUrl = await Api.GetViewerLinkAsync(OrthancStudyId);
            if (string.IsNullOrWhiteSpace(viewerUrl))
            {
                viewerUnavailable = true;
                Notification.Notify(NotificationSeverity.Warning, L["StudyDetails.ViewerUnavailable"], L["StudyDetails.PACSUnavailableShort"]);
            }
        }
        catch (Exception ex)
        {
            viewerUnavailable = true;
            Notification.Notify(NotificationSeverity.Error, L["StudyDetails.ViewerError"], ex.Message);
        }
        finally
        {
            isLoadingViewer = false;
        }
    }

    private async Task OpenViewerExternal()
    {
        if (!string.IsNullOrWhiteSpace(viewerUrl))
            Navigation.NavigateTo(viewerUrl, forceLoad: true);
    }

    private async Task OnSync()
    {
        try
        {
            study = await Api.SyncStudyAsync(OrthancStudyId);
            await LoadStudyAnalyses();
            Notification.Notify(NotificationSeverity.Success, L["StudyDetails.Synced"], L["StudyDetails.SyncedDetail"]);
        }
        catch (Exception ex)
        {
            Notification.Notify(NotificationSeverity.Error, L["Common.Error"], ex.Message);
        }
    }

    // Model selection dialog + start background analysis job
    private async Task OnStartAnalysis()
    {
        if (study?.DbStudyId == null || study.DbStudyId == Guid.Empty)
        {
            Notification.Notify(NotificationSeverity.Error, L["Common.Error"], L["StudyDetails.NoDbId"]);
            return;
        }

        try
        {
            // Get compatible models for this study (by modality)
            var models = await Api.GetCompatibleModelsAsync(study.DbStudyId.Value);
            
            if (!models.Any())
            {
                Notification.Notify(NotificationSeverity.Warning, L["StudyDetails.NoModelAvailable"],
                    L["StudyDetails.NoCompatibleModels", string.Join(", ", study.ModalitiesInStudy)]);
                return;
            }

            // Show model selection dialog
            var result = await Dialog.OpenAsync<ModelSelectionDialog>(L["StudyDetails.SelectModelTitle"],
                new Dictionary<string, object?> { { "Models", models } },
                new DialogOptions { Width = "92vw", Height = "84vh", Resizable = false, Draggable = true });

            if (result is Guid selectedModelId)
            {
                // Start analysis in background (Hangfire job)
                await StartAnalysisJob(study.DbStudyId.Value, selectedModelId);
            }
        }
        catch (Exception ex)
        {
            Notification.Notify(NotificationSeverity.Error, L["Common.Error"], L["Panel.LoadModelsFailed", ex.Message]);
        }
    }

    private async Task StartAnalysisJob(Guid studyId, Guid modelId)
    {
        try
        {
            var jobId = await Api.StartAnalysisAsync(studyId, modelId);
            
            Notification.Notify(NotificationSeverity.Success, L["StudyDetails.AnalysisStarted"],
                L["StudyDetails.AnalysisQueued", $"{jobId:N}"]);
            
            // Navigate to analysis progress page to track job
            Navigation.NavigateTo($"/analysis/{jobId}");
        }
        catch (Exception ex)
        {
            Notification.Notify(NotificationSeverity.Error, L["StudyDetails.AnalysisStartError"], ex.Message);
        }
    }

    private async Task LoadStudyAnalyses()
    {
        if (study?.DbStudyId == null || study.DbStudyId == Guid.Empty)
        {
            studyAnalyses = new();
            return;
        }

        isLoadingAnalyses = true;
        try
        {
            studyAnalyses = await Api.GetStudyAnalysisJobsAsync(study.DbStudyId.Value);
        }
        catch (Exception ex)
        {
            Notification.Notify(NotificationSeverity.Error, L["StudyDetails.AnalysesError"], ex.Message);
            studyAnalyses = new();
        }
        finally
        {
            isLoadingAnalyses = false;
        }
    }

    private void OpenStudyAnalysis(AIAnalysisJobListItemDto analysisJob)
    {
        var path = analysisJob.Status == "Completed"
            ? $"/analysis/{analysisJob.Id}/results"
            : $"/analysis/{analysisJob.Id}";
        Navigation.NavigateTo(path);
    }

    private static BadgeStyle GetStatusBadgeStyle(string status) => status switch
    {
        "Queued" => BadgeStyle.Warning,
        "Running" => BadgeStyle.Info,
        "Completed" => BadgeStyle.Success,
        "Failed" => BadgeStyle.Danger,
        _ => BadgeStyle.Light
    };

    private static string FormatDateTime(DateTime dt)
    {
        return dt.ToString("yyyy-MM-dd HH:mm:ss");
    }

    private static string FormatStudyDate(string? date)
    {
        if (string.IsNullOrWhiteSpace(date) || date.Length < 8) return date ?? "—";
        return $"{date[6..8]}.{date[4..6]}.{date[0..4]}";
    }
}
