@page "/federated-learning"
@attribute [Authorize(Roles = "SuperAdmin")]
@implements IAsyncDisposable
@inject SitimApiClient Api
@inject NavigationManager Navigation
@inject NotificationService Notification
@inject IStringLocalizer<SharedResource> L

<PageTitle>Federated Learning — SITIM</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenColumn Size="12" SizeMD="7">
            <RadzenText Text="Federated Learning" TextStyle="TextStyle.DisplayH5" class="rz-mb-0" />
            <RadzenText Text="@L["FL.Subtitle"]" TextStyle="TextStyle.Body2" style="color: var(--rz-text-secondary-color);" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="5" class="rz-text-align-end">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Text="@L["FL.NewSession"]" Icon="play_circle" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                              Click="@OpenCreateDialog" Disabled="@_loading" />
                <RadzenButton Text="@L["Common.Reload"]" Icon="refresh" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                              Click="@LoadSessionsAsync" IsBusy="@_loading" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End">
        <RadzenColumn Size="12" SizeMD="4" class="rz-text-align-end">
            <RadzenText Text="@L["Common.AutoRefresh5s"]" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard>
        <RadzenStack Gap="0.5rem">
            <RadzenText Text="@L["FL.ConnectedClients"]" TextStyle="TextStyle.Body1" />
            @if (!_connectedClients.Any(c => c.IsOnline))
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Light" AllowClose="false">
                    @L["FL.NoClientsOnline"] <b>FL_INSTITUTION_ID=&lt;InstitutionId GUID&gt;</b>.
                </RadzenAlert>
            }
            else
            {
                <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
                    @foreach (var client in _connectedClients.Where(c => c.IsOnline).OrderBy(c => c.InstitutionId))
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@GetConnectedClientBadgeText(client)" />
                    }
                </div>
            }
        </RadzenStack>
    </RadzenCard>

    @if (_loading)
    {
        <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else if (!_sessions.Any())
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Light" AllowClose="false">
            @L["FL.NoSessions"]
        </RadzenAlert>
    }
    else
    {
        <RadzenStack Gap="0.5rem">
            @foreach (var session in _sessions.OrderByDescending(s => s.CreatedAtUtc))
            {
                <RadzenCard>
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="12" SizeMD="10">
                            <RadzenRow>
                                <RadzenColumn Size="6" SizeMD="3">
                                    <RadzenText Text="@L["Common.Model"]" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
                                    <RadzenText Text="@session.ModelKey" TextStyle="TextStyle.Body2" />
                                </RadzenColumn>
                                <RadzenColumn Size="6" SizeMD="2">
                                    <RadzenText Text="@L["Common.Status"]" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
                                    <div>
                                        <RadzenBadge BadgeStyle="@GetSessionBadgeStyle(session.Status)" Text="@session.Status" />
                                    </div>
                                </RadzenColumn>
                                <RadzenColumn Size="6" SizeMD="2">
                                    <RadzenText Text="@L["FL.Rounds"]" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
                                    <RadzenText Text="@($"{session.CurrentRound}/{session.TotalRounds}")" TextStyle="TextStyle.Body2" />
                                </RadzenColumn>
                                <RadzenColumn Size="6" SizeMD="2">
                                    <RadzenText Text="@L["FL.Participants"]" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
                                    <RadzenText Text="@session.ParticipantsCount.ToString()" TextStyle="TextStyle.Body2" />
                                </RadzenColumn>
                                <RadzenColumn Size="6" SizeMD="3">
                                    <RadzenText Text="@L["Common.CreatedAt"]" TextStyle="TextStyle.Caption" style="color: var(--rz-text-tertiary-color);" />
                                    <RadzenText Text="@FormatDateTime(session.CreatedAtUtc)" TextStyle="TextStyle.Body2" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="2" class="rz-text-align-end">
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.25rem">
                                <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small" Variant="Variant.Text"
                                              title="@L["FL.SessionDetails"]"
                                              Click="@(() => Navigation.NavigateTo($"/federated-learning/sessions/{session.Id}"))" />
                                @if (IsSessionRunning(session.Status))
                                {
                                    <RadzenButton Icon="stop_circle" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Variant="Variant.Text"
                                                  title="@L["FL.StopSession"]"
                                                  Click="@(() => StopSessionAsync(session.Id))" />
                                }
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenCard>
            }
        </RadzenStack>
    }
</RadzenStack>

<SitimModal Show="@_showCreateDialog" OnClose="@CloseCreateDialog">
    <RadzenCard Style="min-width:440px;max-width:680px;padding:2rem;">
        <RadzenText Text="@L["FL.NewFLSession"]" TextStyle="TextStyle.H6" class="rz-mb-4" />
            <RadzenStack Gap="1rem">
                <RadzenFormField Text="@($"{L["FL.ModelKey"]} *")" Style="width:100%">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="_newModelKey" Style="width:100%" Placeholder="retinopathy_resnet18" />
                    </ChildContent>
                </RadzenFormField>

                <RadzenFormField Text="@($"{L["FL.Architecture"]} *")" Style="width:100%">
                    <ChildContent>
                        <RadzenDropDown @bind-Value="_newArchitecture" Data="@ArchitectureOptions"
                                        TextProperty="Label" ValueProperty="Value"
                                        Change="@OnArchitectureChanged" Style="width:100%" />
                    </ChildContent>
                </RadzenFormField>

                <RadzenFormField Text="@($"{L["FL.TotalRounds"]} *")" Style="width:100%">
                    <ChildContent>
                        <RadzenNumeric @bind-Value="_newTotalRounds" Min="1" Step="1" TValue="int" Style="width:100%" />
                    </ChildContent>
                </RadzenFormField>

                <div class="sitim-field-label">
                    @L["FL.ParticipatingInstitutions"] <span class="sitim-required">*</span>
                </div>
                <div class="sitim-institution-picker">
                    @{
                        var activeInstitutions = _institutions.Where(i => i.IsActive).OrderBy(i => i.Name).ToList();
                    }
                    @if (activeInstitutions.Count == 0)
                    {
                        <div class="sitim-institution-empty">
                            <RadzenIcon Icon="domain_disabled" />
                            <span>@L["FL.NoActiveInstitutions"]</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var inst in activeInstitutions)
                        {
                            var isSelected = _selectedInstitutionIds.Contains(inst.Id);
                            var isOnline = _connectedClients.Any(c => c.InstitutionId == inst.Id && c.IsOnline);
                            <div class="@($"sitim-institution-item{(isSelected ? " is-selected" : string.Empty)}{(isOnline ? " is-online" : " is-offline")}")"
                                 @onclick="@(() => ToggleInstitutionSelection(inst.Id))"
                                 role="checkbox"
                                 aria-checked="@isSelected.ToString().ToLowerInvariant()"
                                 tabindex="0">
                                <div class="sitim-institution-check">
                                    <RadzenIcon Icon="@(isSelected ? "check_circle" : "radio_button_unchecked")" />
                                </div>
                                <div class="sitim-institution-info">
                                    <div class="sitim-institution-name">@inst.Name</div>
                                    <div class="sitim-institution-status">
                                        <span class="sitim-status-dot"></span>
                                        @(isOnline ? L["FL.ClientConnected"] : L["FL.ClientDisconnected"])
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="sitim-helper-row">
                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-tertiary-color); margin: 0;">
                        @L["FL.SelectionHint"]
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-tertiary-color); margin: 0;">
                        @L["FL.Selected"] <strong style="color: var(--sitim-accent);">@_selectedInstitutionIds.Count</strong> · @L["FL.Connected"] <strong style="color: var(--sitim-accent);">@_connectedClients.Count(c => c.IsOnline)</strong> / @activeInstitutions.Count
                    </RadzenText>
                </div>

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-2">
                    <RadzenButton Text="@L["Common.Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@CloseCreateDialog" />
                    <RadzenButton Text="@L["FL.StartSession"]" Icon="play_circle" ButtonStyle="ButtonStyle.Primary"
                                  Click="@CreateSessionAsync" IsBusy="@_saving" />
                </RadzenStack>
            </RadzenStack>
    </RadzenCard>
</SitimModal>

@code {
    private List<FLSessionDto> _sessions = [];
    private List<InstitutionResult> _institutions = [];
    private List<FLConnectedClientDto> _connectedClients = [];
    private bool _loading = true;
    private bool _saving;
    private System.Timers.Timer? _refreshTimer;

    private bool _showCreateDialog;
    private string _newModelKey = "retinopathy_resnet18";
    private int _newTotalRounds = 10;
    private string _newArchitecture = DefaultArchitecture;
    private List<Guid> _selectedInstitutionIds = [];

    private const string DefaultArchitecture = "resnet18";

    private sealed record ArchitectureOption(string Value, string Label);

    /// <summary>
    /// Must stay in step with _ARCHITECTURES in fl_common/model_def.py — the control plane
    /// rejects anything it does not know, so an unlisted value fails at session start rather
    /// than silently training the wrong network.
    /// </summary>
    private static readonly ArchitectureOption[] ArchitectureOptions =
    [
        new("resnet18", "ResNet-18 (11.2M params · faster)"),
        new("resnet50", "ResNet-50 (23.5M params · needs more VRAM)")
    ];

    /// <summary>
    /// Keeps the model key aligned with the chosen network so sessions stay
    /// distinguishable in the list, without preventing a custom name.
    /// </summary>
    private void OnArchitectureChanged(object? value)
    {
        var architecture = value?.ToString();
        if (string.IsNullOrWhiteSpace(architecture))
            return;

        foreach (var option in ArchitectureOptions)
        {
            if (_newModelKey == $"retinopathy_{option.Value}")
            {
                _newModelKey = $"retinopathy_{architecture}";
                return;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        StartAutoRefresh();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var sessionsTask = Api.GetFLSessionsAsync();
            var institutionsTask = Api.GetInstitutionsAsync();
            var clientsTask = Api.GetFLConnectedClientsAsync();
            await Task.WhenAll(sessionsTask, institutionsTask, clientsTask);

            _sessions = sessionsTask.Result ?? [];
            _institutions = institutionsTask.Result ?? [];
            _connectedClients = clientsTask.Result ?? [];
        }
        catch (Exception ex)
        {
            Notification.Notify(NotificationSeverity.Error, L["Common.Error"], ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadSessionsAsync()
    {
        _loading = true;
        try
        {
            var sessionsTask = Api.GetFLSessionsAsync();
            var clientsTask = Api.GetFLConnectedClientsAsync();
            await Task.WhenAll(sessionsTask, clientsTask);
            _sessions = sessionsTask.Result ?? [];
            _connectedClients = clientsTask.Result ?? [];
        }
        catch (Exception ex)
        {
            Notification.Notify(NotificationSeverity.Error, L["Common.Error"], ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void StartAutoRefresh()
    {
        _refreshTimer = new System.Timers.Timer(5000);
        _refreshTimer.Elapsed += (_, _) =>
        {
            // Skip API calls when nothing is active, to avoid hammering it
            // with no-op requests. Active sessions trigger a reload every tick.
            if (!_sessions.Any(s => IsSessionRunning(s.Status)))
                return;

            _ = InvokeAsync(LoadSessionsAsync);
        };
        _refreshTimer.AutoReset = true;
        _refreshTimer.Start();
    }

    private void OpenCreateDialog()
    {
        _newModelKey = "retinopathy_resnet18";
        _newTotalRounds = 10;
        _newArchitecture = DefaultArchitecture;
        _selectedInstitutionIds = [];
        _showCreateDialog = true;
    }

    private void CloseCreateDialog()
    {
        _showCreateDialog = false;
    }

    private void ToggleInstitutionSelection(Guid institutionId)
    {
        if (!_selectedInstitutionIds.Remove(institutionId))
            _selectedInstitutionIds.Add(institutionId);
    }

    private async Task CreateSessionAsync()
    {
        if (string.IsNullOrWhiteSpace(_newModelKey))
        {
            Notification.Notify(NotificationSeverity.Warning, L["FL.Validation"], L["FL.ModelKeyRequired"]);
            return;
        }

        if (_newTotalRounds <= 0)
        {
            Notification.Notify(NotificationSeverity.Warning, L["FL.Validation"], L["FL.RoundsPositive"]);
            return;
        }

        if (_selectedInstitutionIds.Count == 0)
        {
            Notification.Notify(NotificationSeverity.Warning, L["FL.Validation"], L["FL.SelectOneInstitution"]);
            return;
        }

        var missingConnectedInstitutionIds = GetMissingConnectedInstitutionIds(_selectedInstitutionIds);
        if (missingConnectedInstitutionIds.Count > 0)
        {
            var missingLabels = missingConnectedInstitutionIds
                .Select(GetInstitutionLabel)
                .OrderBy(v => v)
                .ToList();
            Notification.Notify(
                NotificationSeverity.Warning,
                L["FL.MissingClient"],
                L["FL.MissingClientDetail", string.Join(", ", missingLabels)]);
            return;
        }

        _saving = true;
        try
        {
            var created = await Api.StartFLSessionAsync(_newModelKey.Trim(), _newTotalRounds, _selectedInstitutionIds, _newArchitecture);
            if (created is null)
            {
                Notification.Notify(NotificationSeverity.Error, L["Common.Error"], L["FL.StartFailed"]);
                return;
            }

            Notification.Notify(NotificationSeverity.Success, L["Common.Success"], L["FL.SessionStarted", created.Id]);
            _showCreateDialog = false;
            await LoadSessionsAsync();
        }
        catch (Exception ex)
        {
            Notification.Notify(NotificationSeverity.Error, L["Common.Error"], ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task StopSessionAsync(Guid sessionId)
    {
        try
        {
            var stopped = await Api.StopFLSessionAsync(sessionId);
            if (!stopped)
            {
                Notification.Notify(NotificationSeverity.Error, L["Common.Error"], L["FL.StopFailed"]);
                return;
            }

            Notification.Notify(NotificationSeverity.Warning, L["FL.SessionStopped"], L["FL.SessionStoppedDetail", sessionId]);
            await LoadSessionsAsync();
        }
        catch (Exception ex)
        {
            Notification.Notify(NotificationSeverity.Error, L["Common.Error"], ex.Message);
        }
    }

    private static bool IsSessionRunning(string status) =>
        status is "Running" or "Pending";

    private List<Guid> GetMissingConnectedInstitutionIds(IEnumerable<Guid> selectedInstitutionIds)
    {
        var connectedInstitutionIds = _connectedClients
            .Where(c => c.IsOnline)
            .Select(c => c.InstitutionId)
            .ToHashSet();

        return selectedInstitutionIds
            .Where(id => !connectedInstitutionIds.Contains(id))
            .Distinct()
            .ToList();
    }

    private string GetInstitutionLabel(Guid institutionId)
    {
        var institution = _institutions.FirstOrDefault(i => i.Id == institutionId);
        return institution is null ? institutionId.ToString() : $"{institution.Name} ({institution.Id})";
    }

    private string GetConnectedClientBadgeText(FLConnectedClientDto client)
    {
        var institution = _institutions.FirstOrDefault(i => i.Id == client.InstitutionId);
        var institutionLabel = institution?.Name ?? client.InstitutionId.ToString();
        return $"{institutionLabel} · {client.ClientId}";
    }

    private static BadgeStyle GetSessionBadgeStyle(string status) => status switch
    {
        "Pending" => BadgeStyle.Warning,
        "Running" => BadgeStyle.Info,
        "Completed" => BadgeStyle.Success,
        "Stopped" => BadgeStyle.Warning,
        "Failed" => BadgeStyle.Danger,
        _ => BadgeStyle.Light
    };

    private static string FormatDateTime(DateTime value) => value.ToString("yyyy-MM-dd HH:mm:ss");

    public ValueTask DisposeAsync()
    {
        _refreshTimer?.Dispose();
        return ValueTask.CompletedTask;
    }
}
