@page "/import"
@attribute [Authorize(Roles = "SuperAdmin,Admin,Doctor,Technician")]
@inject SitimApiClient Api
@inject NotificationService Notification
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Import.PageTitle"]</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenText Text="@L["Import.Title"]" TextStyle="TextStyle.DisplayH5" />
    <RadzenCard>
        <RadzenStack Gap="1.5rem">
            <RadzenFormField Text="@L["Import.FileField"]" Variant="Variant.Outlined" Style="width: 100%;">
                <ChildContent>
                    <InputFile OnChange="@OnFileSelected" multiple accept=".zip,.dcm,.dicom" class="rz-textbox" style="padding: 0.5rem;" />
                </ChildContent>
            </RadzenFormField>

            @if (selectedFiles.Count > 0)
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Dark" AllowClose="false" Size="AlertSize.Small">
                    @L["Import.FilesSelected", selectedFiles.Count, FormatFileSize(totalSize)]
                </RadzenAlert>
            }

            <RadzenButton Text="@L["Import.ImportButton"]" Icon="cloud_upload" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large"
                          Click="@OnImport" Disabled="@(selectedFiles.Count == 0 || isUploading)"
                          IsBusy="@isUploading" BusyText="@L["Import.Importing"]" Style="width: fit-content;" />

            @if (isUploading)
            {
                <RadzenStack Gap="0.25rem">
                    <RadzenProgressBar ProgressBarStyle="ProgressBarStyle.Primary"
                                       Value="@_progress"
                                       Mode="@(_progress < 100 ? ProgressBarMode.Determinate : ProgressBarMode.Indeterminate)"
                                       ShowValue="@(_progress < 100)" />
                    <RadzenText Text="@_progressLabel" TextStyle="TextStyle.Caption"
                                style="color: var(--rz-text-tertiary-color);" />
                </RadzenStack>
            }
        </RadzenStack>
    </RadzenCard>

    @* ── Import result ─────────────────────── *@
    @if (importResult is not null)
    {
        <RadzenCard>
            <RadzenText Text="@L["Import.Result"]" TextStyle="TextStyle.H6" class="rz-mb-3" />
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenStack AlignItems="AlignItems.Center">
                        <RadzenIcon Icon="upload_file" style="font-size: 36px; color: var(--rz-success);" />
                        <RadzenText Text="@importResult.UploadedInstances.ToString()" TextStyle="TextStyle.DisplayH4" class="rz-mb-0" />
                        <RadzenText Text="@L["Import.UploadedInstances"]" TextStyle="TextStyle.Caption" />
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenStack AlignItems="AlignItems.Center">
                        <RadzenIcon Icon="folder" style="font-size: 36px; color: var(--rz-info);" />
                        <RadzenText Text="@importResult.OrthancStudyIds.Count.ToString()" TextStyle="TextStyle.DisplayH4" class="rz-mb-0" />
                        <RadzenText Text="@L["Import.DetectedStudies"]" TextStyle="TextStyle.Caption" />
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenStack AlignItems="AlignItems.Center">
                        <RadzenIcon Icon="sync" style="font-size: 36px; color: var(--rz-primary);" />
                        <RadzenText Text="@importResult.SyncedStudies.ToString()" TextStyle="TextStyle.DisplayH4" class="rz-mb-0" />
                        <RadzenText Text="@L["Import.SyncedStudies"]" TextStyle="TextStyle.Caption" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>

            @if (importResult.Errors.Count > 0)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Dark" AllowClose="false" class="rz-mt-3" Title="@L["Import.Warnings"]">
                    <ul>
                        @foreach (var err in importResult.Errors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </RadzenAlert>
            }

            @if (importResult.OrthancStudyIds.Count > 0)
            {
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-3" JustifyContent="JustifyContent.Center">
                    <RadzenButton Text="@L["Import.GoHome"]" Icon="list_alt" ButtonStyle="ButtonStyle.Primary"
                                  Click="@(() => Navigation.NavigateTo("/"))" />
                    @if (importResult.OrthancStudyIds.Count == 1)
                    {
                        <RadzenButton Text="@L["Import.OpenStudy"]" Icon="visibility" ButtonStyle="ButtonStyle.Secondary"
                                      Click="@(() => Navigation.NavigateTo($"/studies/{importResult.OrthancStudyIds[0]}"))" />
                    }
                </RadzenStack>
            }
        </RadzenCard>
    }
</RadzenStack>

@code {
    private List<IBrowserFile> selectedFiles = [];
    private long totalSize;
    private bool isUploading;
    private ImportResult? importResult;

    private double _progress = 0;
    private string _progressLabel = "";

    private void SetProgress(double value, string label)
    {
        _progress = value;
        _progressLabel = label;
        StateHasChanged();
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFiles = e.GetMultipleFiles(100).ToList();
        totalSize = selectedFiles.Sum(f => f.Size);
        importResult = null;
    }

    private async Task OnImport()
    {
        if (selectedFiles.Count == 0) return;

        isUploading = true;
        importResult = null;
        _progress = 0;

        try
        {
            var firstFile = selectedFiles[0];
            if (selectedFiles.Count == 1 && firstFile.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
            {
                SetProgress(10, L["Import.ReadingArchive", firstFile.Name]);
                await using var browserStream = firstFile.OpenReadStream(maxAllowedSize: 1024L * 1024 * 1024);
                var ms = new MemoryStream();
                await browserStream.CopyToAsync(ms);
                ms.Position = 0;

                SetProgress(70, L["Import.SendingToServer"]);
                importResult = await Api.ImportArchiveAsync(ms, firstFile.Name);
            }
            else
            {
                var fileData = new List<(byte[], string)>();
                long bytesReadSoFar = 0;

                for (int i = 0; i < selectedFiles.Count; i++)
                {
                    var file = selectedFiles[i];
                    // Reading phase: 0% → 70%, distributed evenly per file
                    double readStart = (double)i / selectedFiles.Count * 70;
                    SetProgress(readStart, L["Import.ReadingFile", i + 1, selectedFiles.Count, file.Name]);

                    await using var browserStream = file.OpenReadStream(maxAllowedSize: 512L * 1024 * 1024);
                    var ms = new MemoryStream();
                    await browserStream.CopyToAsync(ms);
                    fileData.Add((ms.ToArray(), file.Name));

                    bytesReadSoFar += file.Size;
                    double readEnd = (double)(i + 1) / selectedFiles.Count * 70;
                    SetProgress(readEnd, L["Import.ReadProgress", i + 1, selectedFiles.Count, FormatFileSize(bytesReadSoFar), FormatFileSize(totalSize)]);
                }

                SetProgress(75, L["Import.SendingToServer"]);
                importResult = await Api.ImportFilesAsync(fileData);
            }

            SetProgress(90, L["Import.SyncingStudies"]);

            if (importResult is not null)
            {
                SetProgress(100, "");
                Notification.Notify(NotificationSeverity.Success, L["Import.Succeeded"],
                    L["Import.SucceededDetail", importResult.UploadedInstances, importResult.SyncedStudies]);
            }
            else
            {
                Notification.Notify(NotificationSeverity.Error, L["Import.Error"], L["Import.NoServerResult"]);
            }
        }
        catch (Exception ex)
        {
            Notification.Notify(NotificationSeverity.Error, L["Import.Error"], ex.Message);
        }
        finally
        {
            isUploading = false;
        }
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F2} GB";
    }
}
