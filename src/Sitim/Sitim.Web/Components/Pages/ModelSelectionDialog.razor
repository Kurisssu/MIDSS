@using Sitim.Web.Services
@using Radzen.Blazor
@inject DialogService DialogService
@inject IStringLocalizer<SharedResource> L

<div class="sitim-model-picker-root">
    <div class="sitim-model-picker-header">
        <div class="sitim-model-picker-title">
            <RadzenIcon Icon="psychology" />
            <span>@L["ModelPicker.Title"]</span>
        </div>
        @if (Models is not null && Models.Any())
        {
            <span class="sitim-model-picker-count">@L["ModelPicker.CompatibleCount", Models.Count]</span>
        }
    </div>

    @if (Models == null || !Models.Any())
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false">
            @L["ModelPicker.NoModels"]
        </RadzenAlert>
    }
    else
    {
        <div class="sitim-model-picker-grid">
            <div class="sitim-model-picker-list">
                @foreach (var model in Models.OrderByDescending(m => m.Accuracy ?? 0))
                {
                    var isSelected = model.Id == SelectedModelId;
                    <div class="@($"sitim-model-card{(isSelected ? " is-selected" : string.Empty)}")"
                         @onclick="@(() => SelectModel(model.Id))"
                         role="button"
                         tabindex="0">
                        <div class="sitim-model-card-radio">
                            <RadzenIcon Icon="@(isSelected ? "check_circle" : "radio_button_unchecked")" />
                        </div>
                        <div class="sitim-model-card-body">
                            <div class="sitim-model-card-name">@model.Name</div>
                            <div class="sitim-model-card-meta">
                                <span class="sitim-model-chip is-version">v@(model.Version)</span>
                                @if (!string.IsNullOrWhiteSpace(model.TargetModality))
                                {
                                    <span class="sitim-model-chip is-modality">@model.TargetModality</span>
                                }
                                @if (model.Accuracy.HasValue)
                                {
                                    <span class="sitim-model-accuracy">
                                        <RadzenIcon Icon="trending_up" />
                                        @model.Accuracy.Value.ToString("P1")
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="sitim-model-picker-details">
                @if (SelectedModel is null)
                {
                    <div class="sitim-model-details-empty">
                        <RadzenIcon Icon="article" />
                        <span>@L["ModelPicker.SelectForDetails"]</span>
                    </div>
                }
                else
                {
                    <div class="sitim-model-details-content">
                        <div class="sitim-model-details-header">
                            <div class="sitim-model-details-name">@SelectedModel.Name</div>
                            <div class="sitim-model-details-badges">
                                <span class="sitim-model-chip is-version">v@(SelectedModel.Version)</span>
                                <span class="sitim-model-chip is-modality">@(SelectedModel.TargetModality ?? L["ModelPicker.AnyModality"].Value)</span>
                                <span class="sitim-model-chip is-accuracy">@(SelectedModel.Accuracy?.ToString("P2") ?? L["ModelPicker.AccuracyNA"].Value)</span>
                            </div>
                        </div>

                        <div class="sitim-model-details-field">
                            <div class="sitim-model-details-label">@L["Common.Description"]</div>
                            <div class="sitim-model-details-value">
                                @(string.IsNullOrWhiteSpace(SelectedModel.Description) ? L["ModelPicker.NoDescription"].Value : SelectedModel.Description)
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="sitim-model-picker-actions">
        <RadzenButton Text="@L["Common.Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
        <RadzenButton Text="@L["ModelPicker.StartAnalysis"]" Icon="play_arrow" ButtonStyle="ButtonStyle.Primary"
                      Click="@Select" Disabled="@(SelectedModelId == Guid.Empty)" />
    </div>
</div>

@code {
    [Parameter] public List<AIModelSelectionDto>? Models { get; set; }

    private Guid SelectedModelId = Guid.Empty;
    private AIModelSelectionDto? SelectedModel =>
        Models?.FirstOrDefault(m => m.Id == SelectedModelId);

    protected override void OnParametersSet()
    {
        if (SelectedModelId == Guid.Empty && Models?.Any() == true)
            SelectedModelId = Models.OrderByDescending(m => m.Accuracy ?? 0).First().Id;
    }

    private void Select()
    {
        if (SelectedModelId != Guid.Empty)
        {
            DialogService.Close(SelectedModelId);
        }
    }

    private void SelectModel(Guid modelId)
    {
        SelectedModelId = modelId;
    }

    private void Cancel()
    {
        DialogService.Close();
    }
}
