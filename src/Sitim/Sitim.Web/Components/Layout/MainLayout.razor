@inherits LayoutComponentBase
@implements IDisposable
@inject SitimAuthStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject AuthTokenStore TokenStore
@inject SitimApiClient Api
@inject IStringLocalizer<SharedResource> L

<RadzenComponents />

<AuthorizeView Context="authContext">
    <Authorized>
        <div class="sitim-app-shell">
        <RadzenLayout>
            <RadzenHeader>
                <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0">
                    <RadzenColumn Size="5">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <div @onmouseenter="OnSidebarHandleMouseEnter">
                                <RadzenSidebarToggle Click="@SidebarToggleClick"></RadzenSidebarToggle>
                            </div>
                            <RadzenText Text="SITIM" TextStyle="TextStyle.H5" class="rz-mb-0 rz-display-none rz-display-sm-inline sitim-brand-text" />
                            @if (!string.IsNullOrWhiteSpace(TokenStore.InstitutionName))
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text="@TokenStore.InstitutionName" />
                            }
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="7">
                        <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-px-2">
                            <RadzenIcon Icon="person" style="color: var(--rz-text-color);" />
                            <RadzenText Text="@TokenStore.Email" TextStyle="TextStyle.Body2" class="rz-mb-0" style="color: var(--rz-text-color);" />
                            <RadzenBadge BadgeStyle="@RoleBadgeStyle()" Text="@string.Join(", ", TokenStore.Roles)" />
                            <ThemeSwitcher />
                            <LanguageSwitcher />
                            <RadzenButton Text="@L["Nav.Logout"]" Icon="logout" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@OnLogout" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenHeader>
            <RadzenBody Expanded="@sidebarExpanded">
                <RadzenRow class="rz-mx-auto rz-px-4 rz-pt-2 rz-pt-md-4 rz-pt-lg-6 rz-pt-xl-12 rz-pb-2 rz-pb-lg-12" Style="max-width: 1440px;">
                    <RadzenColumn Size="12">
                        @Body
                    </RadzenColumn>
                </RadzenRow>
            </RadzenBody>
            <RadzenSidebar @bind-Expanded="@sidebarExpanded" @onmouseenter="OnSidebarMouseEnter" @onmouseleave="OnSidebarMouseLeave">
                <RadzenStack AlignItems="Radzen.AlignItems.Center" class="rz-py-4 rz-py-lg-6" Style="padding: var(--rz-panel-menu-item-padding); border-bottom: var(--rz-panel-menu-item-border);">
                    <RadzenIcon Icon="biotech" class="sitim-sidebar-logo" style="font-size: 60px;" />
                    <RadzenText Text="@L["Nav.Tagline"]" TextStyle="TextStyle.Caption" class="rz-mb-0" style="color: var(--rz-text-tertiary-color);" />
                </RadzenStack>
                <RadzenPanelMenu>
                    <AuthorizeView Roles="SuperAdmin,Admin,Doctor,Technician">
                        <RadzenPanelMenuItem Text="@L["Nav.Welcome"]" Icon="home" Path="" />
                    </AuthorizeView>
                    <AuthorizeView Roles="SuperAdmin,Admin,Doctor,Technician">
                        <RadzenPanelMenuItem Text="@L["Nav.Studies"]" Icon="list_alt" Path="studies" />
                    </AuthorizeView>
                    <AuthorizeView Roles="SuperAdmin,Admin,Doctor,Technician">
                        <RadzenPanelMenuItem Text="@L["Nav.Import"]" Icon="cloud_upload" Path="import" />
                    </AuthorizeView>
                    <AuthorizeView Roles="SuperAdmin,Admin,Doctor,Technician">
                        <RadzenPanelMenuItem Text="@L["Nav.AIAnalyses"]" Icon="analytics" Path="ai-analyses" />
                    </AuthorizeView>
                    <AuthorizeView Roles="SuperAdmin,Admin">
                        <RadzenPanelMenuItem Text="@L["Nav.Users"]" Icon="group" Path="users" />
                    </AuthorizeView>
                    <AuthorizeView Roles="SuperAdmin,Admin">
                        <RadzenPanelMenuItem Text="@L["Nav.Admin"]" Icon="admin_panel_settings" Path="admin" />
                    </AuthorizeView>
                    <AuthorizeView Roles="SuperAdmin">
                        <RadzenPanelMenuItem Text="@L["Nav.Institutions"]" Icon="business" Path="institutions" />
                    </AuthorizeView>
                    <AuthorizeView Roles="SuperAdmin,Admin">
                        <RadzenPanelMenuItem Text="@L["Nav.AIModels"]" Icon="psychology" Path="ai-models" />
                    </AuthorizeView>
                    <AuthorizeView Roles="SuperAdmin">
                        <RadzenPanelMenuItem Text="@GetFederatedLearningMenuText()" Icon="hub" Path="federated-learning" />
                    </AuthorizeView>
                </RadzenPanelMenu>
            </RadzenSidebar>
        </RadzenLayout>
        <SitimFooter />
        </div>
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    bool sidebarExpanded = false;
    private int _activeFlSessions;
    private System.Timers.Timer? _flBadgeRefreshTimer;
    private bool _flBadgeInitialized;

    void SidebarToggleClick()
    {
        sidebarExpanded = !sidebarExpanded;
    }

    void OnSidebarHandleMouseEnter()
    {
        sidebarExpanded = true;
    }

    void OnSidebarMouseEnter()
    {
        sidebarExpanded = true;
    }

    void OnSidebarMouseLeave()
    {
        sidebarExpanded = false;
    }

    BadgeStyle RoleBadgeStyle()
    {
        if (TokenStore.IsSuperAdmin) return BadgeStyle.Danger;
        if (TokenStore.Roles.Contains("Admin")) return BadgeStyle.Warning;
        return BadgeStyle.Info;
    }

    async Task OnLogout()
    {
        await AuthProvider.LogoutAsync();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !TokenStore.IsSuperAdmin || _flBadgeInitialized)
            return;

        _flBadgeInitialized = true;
        await RefreshFederatedLearningBadgeAsync();
        StartFederatedLearningBadgeRefresh();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshFederatedLearningBadgeAsync()
    {
        var sessions = await Api.GetFLSessionsAsync();
        _activeFlSessions = sessions.Count(s => s.Status is "Pending" or "Running");
    }

    private void StartFederatedLearningBadgeRefresh()
    {
        _flBadgeRefreshTimer = new System.Timers.Timer(15000);
        _flBadgeRefreshTimer.Elapsed += (_, _) =>
        {
            if (!TokenStore.IsSuperAdmin)
                return;

            _ = InvokeAsync(async () =>
            {
                await RefreshFederatedLearningBadgeAsync();
                StateHasChanged();
            });
        };
        _flBadgeRefreshTimer.AutoReset = true;
        _flBadgeRefreshTimer.Start();
    }

    private string GetFederatedLearningMenuText() =>
        _activeFlSessions > 0
            ? $"Federated Learning ({_activeFlSessions})"
            : "Federated Learning";

    public void Dispose()
    {
        _flBadgeRefreshTimer?.Dispose();
    }
}
