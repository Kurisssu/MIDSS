@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<footer class="sitim-footer">
    <div class="sitim-footer-inner">
        <div class="sitim-footer-grid">

            <div class="sitim-footer-brand">
                <div class="sitim-footer-logo">
                    <RadzenIcon Icon="biotech" />
                    <span>SITIM</span>
                </div>
                <p class="sitim-footer-tagline">
                    @L["Footer.Tagline"]
                </p>
                <div class="sitim-footer-status" role="status" aria-live="polite">
                    <span class="sitim-footer-status-dot" aria-hidden="true"></span>
                    <span class="sitim-footer-status-text">@L["Footer.AllSystemsOperational"]</span>
                </div>
            </div>

            <div class="sitim-footer-col">
                <h4 class="sitim-footer-col-title">@L["Footer.Resources"]</h4>
                <ul class="sitim-footer-links">
                    <li><a href="/">@L["Nav.Welcome"]</a></li>
                    <li><a href="/studies">@L["Nav.Studies"]</a></li>
                    <li><a href="/ai-analyses">@L["Nav.AIAnalyses"]</a></li>
                    <li><a href="/ai-models">@L["Nav.AIModels"]</a></li>
                </ul>
            </div>

            <div class="sitim-footer-col">
                <h4 class="sitim-footer-col-title">@L["Footer.Project"]</h4>
                <ul class="sitim-footer-links">
                    <li>
                        <a href="https://github.com/Kurisssu/Sitim" target="_blank" rel="noopener noreferrer">
                            @L["Footer.SourceCode"]
                        </a>
                    </li>
                    <li>
                        <a href="https://github.com/Kurisssu/Sitim/issues" target="_blank" rel="noopener noreferrer">
                            @L["Footer.Issues"]
                        </a>
                    </li>
                    <li>
                        <a href="/hangfire" target="_blank" rel="noopener noreferrer">
                            Hangfire dashboard
                        </a>
                    </li>
                    <li>
                        <a href="/federated-learning">Federated Learning</a>
                    </li>
                </ul>
            </div>

            <div class="sitim-footer-col sitim-footer-connect">
                <h4 class="sitim-footer-col-title">Contact</h4>
                <a class="sitim-footer-contact" href="mailto:morarucristian004@gmail.com">
                    morarucristian004@gmail.com
                </a>
                <div class="sitim-footer-socials" role="list">
                    <a href="https://github.com/Kurisssu/Sitim"
                       class="sitim-footer-social"
                       target="_blank" rel="noopener noreferrer"
                       aria-label="GitHub repository" title="GitHub">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.3-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11 11 0 015.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.23 2.76.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14v3.18c0 .31.21.67.8.56C20.22 21.38 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
                        </svg>
                    </a>
                    <a href="https://www.linkedin.com/"
                       class="sitim-footer-social"
                       target="_blank" rel="noopener noreferrer"
                       aria-label="LinkedIn profile" title="LinkedIn">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.05-1.86-3.05-1.86 0-2.15 1.45-2.15 2.95v5.67H9.34V9h3.4v1.56h.05c.47-.89 1.62-1.83 3.34-1.83 3.57 0 4.32 2.35 4.32 5.4v6.32zM5.34 7.43a2.06 2.06 0 110-4.12 2.06 2.06 0 010 4.12zm1.77 13.02H3.56V9h3.55v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
                        </svg>
                    </a>
                    <a href="mailto:morarucristian004@gmail.com"
                       class="sitim-footer-social"
                       aria-label="Send email" title="Email">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M2 5.5a2 2 0 012-2h16a2 2 0 012 2v13a2 2 0 01-2 2H4a2 2 0 01-2-2v-13zm2.4 0L12 11.94 19.6 5.5H4.4zm15.6 1.86l-7.27 6.15a1 1 0 01-1.46 0L4 7.36V18.5h16V7.36z"/>
                        </svg>
                    </a>
                </div>
            </div>

        </div>

        <div class="sitim-footer-bottom">
            <span class="sitim-footer-copyright">
                © @DateTime.UtcNow.Year SITIM. @L["Footer.AllRightsReserved"]
            </span>
            <nav class="sitim-footer-legal" aria-label="Legal">
                <a href="#">@L["Footer.Terms"]</a>
                <span class="sitim-footer-legal-sep" aria-hidden="true">·</span>
                <a href="#">@L["Footer.Privacy"]</a>
                <span class="sitim-footer-legal-sep" aria-hidden="true">·</span>
                <a href="#">Cookies</a>
            </nav>
            <span class="sitim-footer-meta">v1.0 · @DateTime.UtcNow.ToString("yyyy.MM.dd")</span>
        </div>
    </div>
</footer>
