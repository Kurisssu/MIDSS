@using Sitim.Web.Models
@inject IStringLocalizer<SharedResource> L

@*
    Reusable editor for a model's output-class interpretation: per-class name,
    clinical severity and recommendations. Mutates the supplied Rows list in place,
    so the parent dialog can read it back directly on submit.
*@

<RadzenStack Gap="0.75rem">
    <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0">
        @L["ClassEditor.Title"]
    </RadzenText>
    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-tertiary-color rz-mb-0">
        @L["ClassEditor.Hint1"]
        @L["ClassEditor.Hint2"] <strong>none</strong>, <strong>mild</strong>,
        <strong>moderate</strong>, <strong>severe</strong>, <strong>proliferative</strong>.
        @L["ClassEditor.Hint3"]
    </RadzenText>

    @if (Rows.Count == 0)
    {
        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-tertiary-color">
            @L["ClassEditor.NoClasses"]
        </RadzenText>
    }

    @for (var i = 0; i < Rows.Count; i++)
    {
        var index = i;
        var row = Rows[index];
        <RadzenCard Variant="Variant.Outlined" class="rz-p-3">
            <RadzenStack Gap="0.5rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenBadge Text="@L["Results.ClassNo", index]" BadgeStyle="BadgeStyle.Light" Variant="Variant.Flat" />
                    <RadzenButton Icon="close"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.ExtraSmall"
                                  Click="@(() => RemoveRow(index))"
                                  title="@L["ClassEditor.RemoveClass"]" />
                </RadzenStack>
                <RadzenRow Gap="0.5rem">
                    <RadzenColumn Size="12" SizeMD="7">
                        <RadzenFormField Text="@L["ClassEditor.ClassName"]" Variant="Variant.Outlined" class="w-100">
                            <RadzenTextBox @bind-Value="@row.Name" class="w-100" Placeholder="Moderate DR" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="5">
                        <RadzenFormField Text="@L["Results.Severity"]" Variant="Variant.Outlined" class="w-100">
                            <RadzenTextBox @bind-Value="@row.Severity" class="w-100" Placeholder="moderate" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenFormField Text="@L["ClassEditor.Recommendations"]" Variant="Variant.Outlined" class="w-100">
                    <RadzenTextArea @bind-Value="@row.RecommendationsText"
                                    class="w-100"
                                    Rows="3"
                                    Placeholder="@L["ClassEditor.RecommendationsPlaceholder"]" />
                </RadzenFormField>
            </RadzenStack>
        </RadzenCard>
    }

    <div>
        <RadzenButton Text="@L["ClassEditor.AddClass"]"
                      Icon="add"
                      ButtonStyle="ButtonStyle.Light"
                      Size="ButtonSize.Small"
                      Click="@AddRow" />
    </div>
</RadzenStack>

@code {
    /// <summary>Bound list of rows; mutated in place so the parent reads it on submit.</summary>
    [Parameter] public List<ClassInterpretationRow> Rows { get; set; } = new();

    private void AddRow() => Rows.Add(new ClassInterpretationRow());

    private void RemoveRow(int index)
    {
        if (index >= 0 && index < Rows.Count)
            Rows.RemoveAt(index);
    }
}
