# Copy this file to FederatedLearning/.env (not tracked by git) and replace the CHANGE_ME values.
# docker compose -f FederatedLearning/docker-compose.fl.yml reads FederatedLearning/.env automatically.
# The FL_* experiment parameters below are the ones used for the ICCP 2026 article.

# ── FL Server ────────────────────────────────────────────────────────
FL_MIN_AVAILABLE_CLIENTS=3
FL_MIN_FIT_CLIENTS=3
FL_MIN_EVALUATE_CLIENTS=3

# ── Batch size (trimis clienților prin fit_config) ───────────────────
# GPU 8 GB partajat de 3 clienți simultani @512×512. La batch 4 s-au folosit ~4.15 GB.
# Batch 8 a cauzat CUDA OOM pe un client (sesiune oprită la runda 6) cu dataset-ul
# complet APTOS — readus la 4 pentru stabilitate. Nu urca peste 4 fără să verifici VRAM.
FL_BATCH_SIZE=4

# ── Dataset thresholds ───────────────────────────────────────────────
# inst3 are 3 studii (2+1 per clasă), inst1/inst2 au 5/4 studii
FL_MIN_LABELED_SAMPLES=2
FL_MIN_SAMPLES_PER_CLASS=1

# ── Orthanc URLs (host.docker.internal = host-ul Windows din container)
FL_INST1_ORTHANC_BASE_URL=http://host.docker.internal:8042
FL_INST2_ORTHANC_BASE_URL=http://host.docker.internal:8043
FL_INST3_ORTHANC_BASE_URL=http://host.docker.internal:8044

# ── Credentiale Orthanc (inst2 si inst3 cer autentificare)
FL_ORTHANC_USERNAME=CHANGE_ME_orthanc_user
FL_ORTHANC_PASSWORD=CHANGE_ME_orthanc_password

# ── Institution GUIDs (trebuie să corespundă cu InstitutionId din DB SITIM)
# Decomentează și ajustează dacă GUIDurile din DB diferă de valorile default
# inst1 -> mci (Orthanc 8042), inst2 -> mikof (8043), inst3 -> ovisus (8044)
FL_INST1_INSTITUTION_ID=d4ad6e33-be99-48a7-a451-38aa5c50580c
FL_INST2_INSTITUTION_ID=0a97709f-9185-4d81-80bd-85deccbfecda
FL_INST3_INSTITUTION_ID=32413854-4e3a-46c3-b00a-592844520ac7
# Doar valoare implicita: arhitectura reala se alege per sesiune din UI-ul SITIM
FL_ARCHITECTURE=resnet18
