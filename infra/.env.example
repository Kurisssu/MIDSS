# Copy this file to infra/.env (not tracked by git) and replace the values.
# docker compose -f infra/docker-compose.yml reads infra/.env automatically.

# PostgreSQL (user and database are "midss"; see docker-compose.yml)
# Must match the Password= part of ConnectionStrings:Default in the API user-secrets.
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# MinIO root credentials (root user is "midss"; see docker-compose.yml)
# Must match MinIO:SecretKey in the API user-secrets. MinIO requires at least 8 characters.
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
